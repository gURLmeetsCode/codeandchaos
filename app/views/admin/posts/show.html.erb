<% content_for :title, page_title(@post.title) %>

<main class="admin-main">
  <div class="panel">
    <div class="admin-main__header">
      <div>
        <h1><%= @post.title %></h1>
        <p><%= @post.topic_label %> · <%= number_with_delimiter(@post.view_count) %> views</p>
      </div>
      <div class="d-flex gap-2 flex-wrap">
        <%= link_to "Back", admin_posts_path, class: "btn btn-outline-dark" %>
        <%= render "admin/posts/actions", post: @post %>
      </div>
    </div>

    <div class="article__body markdown-body">
      <%= render_markdown(@post.body) %>
    </div>
  </div>
</main>
