<% content_for :title, page_title("Admin") %>

<main class="admin-main">
  <div class="panel" style="max-width: 28rem; margin-inline: auto; text-align: center;">
    <h1 class="h4 mb-2">Admin</h1>
    <p class="empty mb-4">Sign in to manage posts and view metrics.</p>
    <div class="d-grid gap-2">
      <%= link_to "Sign in", new_user_session_path, class: "btn btn-primary" %>
      <%= link_to "Back to blog", root_path, class: "btn btn-outline-dark" %>
    </div>
    <p class="empty mt-4 mb-0" style="font-size: 0.9rem;">
      New accounts aren’t open publicly. Create your admin user via seeds or the Rails console.
    </p>
  </div>
</main>
