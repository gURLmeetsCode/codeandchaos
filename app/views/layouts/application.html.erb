<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for?(:title) ? yield(:title) : page_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body class="<%= admin_area? ? "admin-body" : nil %>">
    <% if admin_area? %>
      <%= render "shared/admin_nav" %>
    <% else %>
      <%= render "shared/public_nav" %>
    <% end %>

    <% if notice.present? || alert.present? %>
      <div class="flash-wrap">
        <% if notice.present? %>
          <div class="alert alert-success py-2 px-3" role="status"><%= notice %></div>
        <% end %>
        <% if alert.present? %>
          <div class="alert alert-danger py-2 px-3" role="alert"><%= alert %></div>
        <% end %>
      </div>
    <% end %>

    <%= yield %>

    <% unless admin_area? %>
      <footer class="site-footer">
        <div class="site-footer__inner">
          <div>
            <%= brand_mark %>
            <p>
              Notes on learning, code,<br>
              productivity, and self-improvement.
            </p>
          </div>


          <nav class="footer-nav" aria-label="Footer navigation">
            <%= link_to "Notes", posts_path %>
            <%= link_to "Start here", start_path %>
            <%= link_to "About", about_path %>
          </nav>


          <div class="footer-meta">
            © <%= Time.current.year %> gURLMeetsCode
            <br>
            Built with ❤️ and Ruby on Rails
          </div>
        </div>
      </footer>
    <% end %>
  </body>
</html>
