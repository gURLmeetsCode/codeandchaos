<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for?(:title) ? yield(:title) : page_title("Sign in") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">

    <link rel="icon" href="/icon.png" type="image/png">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body class="auth-body">
    <% if notice.present? || alert.present? %>
      <div class="flash-wrap">
        <% if notice.present? %>
          <div class="alert alert-success py-2 px-3" role="status"><%= notice %></div>
        <% end %>
        <% if alert.present? %>
          <div class="alert alert-danger py-2 px-3" role="alert"><%= alert %></div>
        <% end %>
      </div>
    <% end %>

    <main class="auth-main">
      <%= yield %>
    </main>
  </body>
</html>
