<ul class="topic-list">

  <% @topics&.each do |name, count| %>

    <li class="topic-row">
      <%= link_to topic_filter_path(name),
          class: [ "topic-row__link", ("active" if topic_filter_active?(name)) ].compact.join(" ") do %>
        <span
          class="topic"
          style="--topic-color: <%= topic_color(name) %>"
        >
          <%= name %>
        </span>

        <span class="topic-count">
          <%= count %>
        </span>
      <% end %>
    </li>

  <% end %>

</ul>
