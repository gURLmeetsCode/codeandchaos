<ul class="topic-list">

  <% @topics&.each do |topic| %>

    <li class="topic-row">

      <span
        class="topic"
        style="--topic-color: <%= topic_color(topic.name) %>"
      >
        <%= topic.name %>
      </span>


      <span class="topic-count">
        <%= topic.count %>
      </span>

    </li>

  <% end %>

</ul>
