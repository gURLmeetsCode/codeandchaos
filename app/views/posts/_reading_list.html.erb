<section class="sidebar-section sidebar-reading">

  <h2 class="sidebar-title">
    Currently reading
  </h2>

  <% if currently_reading_books.any? %>
    <ul class="reading-list">
      <% currently_reading_books.each do |book| %>
        <li class="reading-list__item">
          <%= link_to book["url"], target: "_blank", rel: "noopener noreferrer", class: "reading-list__link" do %>
            <% if book["cover"].present? || book["cover_url"].present? %>
              <div class="reading-list__cover-wrap">
                <%= book_cover_tag(book) %>
              </div>
            <% end %>

            <div class="reading-list__details">
              <span class="reading-list__title"><%= book["title"] %></span>
              <span class="reading-list__author"><%= book["author"] %></span>
            </div>
          <% end %>
        </li>
      <% end %>
    </ul>

    <% if goodreads_profile_url.present? %>
      <%= link_to "See all on Goodreads →", goodreads_profile_url, target: "_blank", rel: "noopener noreferrer", class: "text-link" %>
    <% end %>
  <% else %>
    <p class="sidebar-about__text">Nothing on the nightstand right now.</p>
  <% end %>

</section>
